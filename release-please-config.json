{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "packages": {
    "app": {
      "component": "cli",
      "release-type": "go",
      "changelog-path": "ark-cli/CHANGELOG.md",
      "exclude-paths": [
        "app/ark-web"
      ]
    },
    "container": {
      "component": "container",
      "release-type": "simple",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance Improvements"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "build",
          "section": "Image Build"
        }
      ]
    }
  }
}
